# Mutual Fund FAQ Assistant - Environment Configuration Example
# Copy this file to .env and configure your keys if needed:
# cp .env.example .env

# Provider: Google Gemini or OpenAI (Optional - system includes local deterministic generator)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
LLM_PROVIDER=local
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.0
PORT=8501
